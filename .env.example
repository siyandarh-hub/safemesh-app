# Copy this file to ".env" (same folder as README.md) and change the values.
# Never commit or share the real .env file.

PORT=3847

# Needed to create the FIRST admin account. Pick something long and private.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SAFEMESH_ADMIN_KEY=change-me

# Signs login sessions. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SAFEMESH_JWT_SECRET=change-me

# Set when you go live. In production, reset codes are never printed to the console.
# NODE_ENV=production

# Behind a reverse proxy / hosting platform (Nginx, Render, Railway…)? Set to true so IPs in the log are real.
# TRUST_PROXY=true

# ── Password-reset codes: pick ONE e-mail provider and/or ONE SMS provider ──
# E-mail via Resend (https://resend.com):
# SAFEMESH_MAIL_PROVIDER=resend
# RESEND_API_KEY=
# MAIL_FROM=SafeMesh <no-reply@yourdomain.co.za>
#
# E-mail via any SMTP server:
# SAFEMESH_MAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=SafeMesh <no-reply@yourdomain.co.za>
#
# SMS via Twilio:
# SAFEMESH_SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
#
# SMS via BulkSMS (South Africa):
# SAFEMESH_SMS_PROVIDER=bulksms
# BULKSMS_TOKEN_ID=
# BULKSMS_TOKEN_SECRET=
#
# SAFEMESH_DEFAULT_COUNTRY_CODE=27   # turns 082… into +2782…

# ── HTTPS / security ──
# Local test over HTTPS (self-signed certificate, browser shows a one-time warning):  npm run start:https
# Real certificate on this server:
# SAFEMESH_TLS_CERT=/etc/letsencrypt/live/yourdomain/fullchain.pem
# SAFEMESH_TLS_KEY=/etc/letsencrypt/live/yourdomain/privkey.pem
# SAFEMESH_HTTP_REDIRECT_PORT=80     # also listen on :80 only to redirect to https
# FORCE_HTTPS=true                   # redirect http→https (default: on when NODE_ENV=production)
# SAFEMESH_PUBLIC_HOST=safemesh.example.co.za   # host used in redirects (default: the Host header)
# SAFEMESH_CSP=enforce               # enforce | report-only | off  (default: enforce in production, report-only otherwise)
# SAFEMESH_CORS_ORIGINS=             # leave empty: app and API share one origin. Comma-separated list only if you host the front end elsewhere
# With docker-compose.https.yml (Caddy gets a free certificate automatically):
# DOMAIN=safemesh.example.co.za
# ACME_EMAIL=you@example.co.za

# ── Responder vetting ──
# SAFEMESH_VETTING_DAYS=365          # how long an approval stays valid before the responder is suspended (0 = never expires)

# Other options
# SAFEMESH_LOG_MAX=20000            # audit-log entries to keep
# SAFEMESH_DB_FILE=                 # custom path for the SQLite file

# --- Supabase (PostgreSQL) -------------------------------------------------
# Set this so accounts and alerts survive redeploys. Use the Supabase "Session pooler" string.
# Leave it empty to use the local SQLite file in data/ instead.
# DATABASE_URL=postgresql://postgres.YOURREF:YOURPASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
